  "description": "CodeArena full-stack coding assessment platform",
  "scripts": {
    "start": "node backend/dist/index.js",
    "dev": "concurrently -k \"tsx watch backend/src/index.ts\" \"vite --config frontend/vite.config.mts --host 0.0.0.0\"",
    "build": "tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.mts",
    "test": "tsx --test backend/test/*.test.ts"
