    "archiver": "^8.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
