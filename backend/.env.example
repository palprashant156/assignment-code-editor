PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codearena
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Comma-separated list of allowed frontend origins (e.g. production and preview URLs).
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIR=backend/uploads

# Bootstrap an instructor on first start. Change this password for your environment.
ADMIN_EMAIL=admin@codearena.dev
ADMIN_PASSWORD=change-this-before-deploying
